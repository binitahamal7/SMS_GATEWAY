# Secret key used to sign and verify JWT login tokens.
JWT_SECRET="replace-with-a-long-random-string"

# Port the API server listens on. The API will be available at http://localhost:<PORT>
PORT=3000

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Works with a local PostgreSQL or a free cloud database (for example Neon: https://neon.tech).
# Cloud databases usually need ?sslmode=require at the end.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"